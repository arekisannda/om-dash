;;; Commentary:

;; Commands operating on the item (issue, pull request, draft, etc.) on
;; the current row of a table generated by a forge block, e.g.
;; `om-dash-github'.
;;
;; This file is the contract between commands and forge backends:
;;
;;  - each command `om-dash-forge-ACTION' finds the backend from the
;;    name of the enclosing block (“#+BEGIN: om-dash-github“ → `github'),
;;    builds the context (see `om-dash--forge-context'), and calls the
;;    generic function `om-dash-forge--ACTION' with the backend symbol;
;;
;;  - each backend's commands file (e.g. om-dash-github-commands.el)
;;    registers itself with `om-dash--forge-register-backend' and
;;    implements every generic function of this file, 1:1;
;;
;;  - if a backend can't do something (e.g. no drafts), its method
;;    reports it with `om-dash--forge-unsupported', which is not an
;;    error; a backend method that is missing is an error.
;;
;; Key bindings of all commands are defined here, in
;; `om-dash-command-map'.

;;; Code:

(require 'om-dash-core)
(require 'om-dash-mode)
(require 'cl-lib)

;;; Backends

(defvar om-dash--forge-backends nil
  "Alist of (BLOCK-NAME . BACKEND) for forge blocks.
E.g. (“om-dash-github“ . github).  Filled by
`om-dash--forge-register-backend'.")

(defun om-dash--forge-register-backend (block-name backend)
  "Register BACKEND symbol as handler of items in BLOCK-NAME blocks."
  (setf (alist-get block-name om-dash--forge-backends nil nil #'equal)
        backend))

(defun om-dash--forge-context ()
  "Return context of the forge item on the current row.

The context is a plist:

  :backend  Backend symbol, from the name of the enclosing block.
  :block    Name of the enclosing block, e.g. “om-dash-github“.
  :params   Effective block parameters: drawer properties of enclosing
            headings, overridden by inline “#+BEGIN:“ parameters
            (see `om-dash--block-params').
  :url      Target of the first org link on the row, or nil (e.g. for
            a new row typed into the table).
  :marker   Marker at point, to update the row after asynchronous
            steps (e.g. editing text in a buffer).

Point stays on the row when the backend method is called, so it can
also read cells of the row (see `om-dash--table-row-values')."
  (let* ((block (or (om-dash--dblock-name)
                    (user-error "Om-dash: not inside om-dash block")))
         (backend (or (cdr (assoc block om-dash--forge-backends))
                      (user-error "Om-dash: %s is not a forge block" block))))
    (list :backend backend
          :block block
          :params (om-dash--block-params block)
          :url (om-dash--row-link)
          :marker (point-marker))))

(defun om-dash--forge-column-at-point ()
  "Return header of the table column at point, or nil."
  (when (and (org-at-table-p) (not (org-at-table-hline-p)))
    (let ((index (org-table-current-column)))
      (when (> index 0)
        (nth (1- index) (om-dash--table-header))))))

(defun om-dash--forge-unsupported (backend feature &optional hint)
  "Report that BACKEND doesn't support FEATURE; not an error.
FEATURE is a description like “closing draft issues“.  HINT is an
optional suggestion shown in parentheses.  Returns nil."
  (message "Om-dash: %s is not supported by %s%s"
           feature backend
           (if hint (format " (%s)" hint) ""))
  nil)

(defun om-dash--forge-call (generic &rest args)
  "Call GENERIC with backend of the current row, its context, and ARGS."
  (let ((context (om-dash--forge-context)))
    (apply generic (plist-get context :backend) context args)))

;;; Generic functions (implemented by every backend)

(cl-defgeneric om-dash-forge--set-field (backend context column)
  "Set field of the item in CONTEXT shown in COLUMN (table header).
BACKEND decides which columns can be changed and how the new value is
read (e.g. with completion); other columns are an error."
  (ignore context column)
  (error "Om-dash: %s backend doesn't implement set-field" backend))

(cl-defgeneric om-dash-forge--create-item (backend context arg)
  "Create item from the new row in CONTEXT; with ARG, create a draft."
  (ignore context arg)
  (error "Om-dash: %s backend doesn't implement create-item" backend))

(cl-defgeneric om-dash-forge--create-draft (backend context arg)
  "Create draft from the new row in CONTEXT; with ARG, create an item."
  (ignore context arg)
  (error "Om-dash: %s backend doesn't implement create-draft" backend))

(cl-defgeneric om-dash-forge--set-parent (backend context)
  "Set parent of the item in CONTEXT (e.g. parent issue of a sub-issue)."
  (ignore context)
  (error "Om-dash: %s backend doesn't implement set-parent" backend))

(cl-defgeneric om-dash-forge--convert-draft (backend context)
  "Convert the draft in CONTEXT to an item (e.g. issue)."
  (ignore context)
  (error "Om-dash: %s backend doesn't implement convert-draft" backend))

(cl-defgeneric om-dash-forge--edit-body (backend context)
  "Edit body of the item in CONTEXT."
  (ignore context)
  (error "Om-dash: %s backend doesn't implement edit-body" backend))

(cl-defgeneric om-dash-forge--delete-item (backend context arg)
  "Remove the item in CONTEXT from its project; with ARG, delete it."
  (ignore context arg)
  (error "Om-dash: %s backend doesn't implement delete-item" backend))

;;; Commands

;;;###autoload
(defun om-dash-forge-set-field ()
  "Set the field of the item on the current row shown in the column at point.

The item is taken from the first link on the row of a table generated
by a forge block, e.g. `om-dash-github'.  The field is chosen by the
column of the cell at point (e.g. “state“, “status“, “tags“).
Which columns can be changed, and how the new value is read, depends
on the backend, see `om-dash-forge--set-field'.  Columns that can't be
changed (e.g. “no.“, “author“) are an error."
  (interactive)
  (om-dash--forge-call #'om-dash-forge--set-field
                       (or (om-dash--forge-column-at-point)
                           (user-error "Om-dash: point is not in a table cell"))))

;;;###autoload
(defun om-dash-forge-create-item (&optional arg)
  "Create item (e.g. issue) from the new table row at point.
With prefix ARG, create a draft instead, as `om-dash-forge-create-draft'.

Type a new row in a table generated by a forge block, fill in cells,
and run this command.  Which cells are used depends on the backend,
see `om-dash-forge--create-item'."
  (interactive "P")
  (om-dash--forge-call #'om-dash-forge--create-item arg))

;;;###autoload
(defun om-dash-forge-create-draft (&optional arg)
  "Create draft from the new table row at point.
With prefix ARG, create an item instead, as `om-dash-forge-create-item'.

Type a new row in a table generated by a forge block, fill in cells,
and run this command.  Which cells are used depends on the backend,
see `om-dash-forge--create-draft'."
  (interactive "P")
  (om-dash--forge-call #'om-dash-forge--create-draft arg))

;;;###autoload
(defun om-dash-forge-set-parent ()
  "Set parent of the item on the current row (e.g. parent issue).
Unlike `om-dash-forge-set-field' on “parent“ column, works anywhere
on the row, also when the table doesn't show parents.  See
`om-dash-forge--set-parent'."
  (interactive)
  (om-dash--forge-call #'om-dash-forge--set-parent))

;;;###autoload
(defun om-dash-forge-convert-draft ()
  "Convert the draft on the current row to an item (e.g. issue).
How the item is created (e.g. which repository) depends on the
backend, see `om-dash-forge--convert-draft'."
  (interactive)
  (om-dash--forge-call #'om-dash-forge--convert-draft))

;;;###autoload
(defun om-dash-forge-edit-body ()
  "Edit body of the item on the current row in a buffer.
See `om-dash-forge--edit-body'."
  (interactive)
  (om-dash--forge-call #'om-dash-forge--edit-body))

;;;###autoload
(defun om-dash-forge-delete-item (&optional arg)
  "Remove the item on the current row from its project.
With prefix ARG, delete the item permanently instead.  See
`om-dash-forge--delete-item'."
  (interactive "P")
  (om-dash--forge-call #'om-dash-forge--delete-item arg))

;;; Key bindings

;; forge commands in `om-dash-command-map' (prefix `om-dash-mode-prefix-key')
(define-key om-dash-command-map (kbd "s") #'om-dash-forge-set-field)
(define-key om-dash-command-map (kbd "n") #'om-dash-forge-create-item)
(define-key om-dash-command-map (kbd "N") #'om-dash-forge-create-draft)
(define-key om-dash-command-map (kbd "e") #'om-dash-forge-edit-body)
(define-key om-dash-command-map (kbd "d") #'om-dash-forge-delete-item)
(define-key om-dash-command-map (kbd "c") #'om-dash-forge-convert-draft)
(define-key om-dash-command-map (kbd "p") #'om-dash-forge-set-parent)

(provide 'om-dash-forge-commands)
;;; om-dash-forge-commands.el ends here
